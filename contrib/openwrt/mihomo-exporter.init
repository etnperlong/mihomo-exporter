#!/bin/sh /etc/rc.common

# OpenWRT procd service for a manually installed mihomo-exporter binary.
# The exporter discovers /etc/mihomo-exporter/config.yaml by default.

# shellcheck disable=SC2034 # rc.common reads these variables when loading the script.
START=99
# shellcheck disable=SC2034 # rc.common reads these variables when loading the script.
USE_PROCD=1

PROG="/usr/bin/mihomo-exporter"

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param user nobody
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
